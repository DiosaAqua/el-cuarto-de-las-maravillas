# Copiá como .env.local (desarrollo) o configurá estas variables en el hosting
# Clave para firmar la cookie de sesión — obligatoria. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Administrador inicial: se crea solo la primera vez que arranca la app
ADMIN_EMAIL=admin@velure.com
ADMIN_PASSWORD=cambiar-esta-clave-ahora

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
